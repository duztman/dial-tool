{"leaders":[{"page":"01","pts":[[248.81999999999996,160.11999999999998],[248.81999999999996,164.85999999999999]],"text":"Undo · ⌘Z","through":false,"box":null},{"page":"01","pts":[[255.85999999999999,160.11999999999998],[255.85999999999999,164.85999999999999]],"text":"Redo · ⇧⌘Z","through":false,"box":null},{"page":"03","pts":[[62.80222222222221,69.47222222222223],[51.47999999999999,69.47222222222223]],"text":"Switches the panel; the dial and the time stay as they are.","through":false,"box":null},{"page":"03","pts":[[64.75777777777776,82.91666666666666],[51.47999999999999,82.91666666666666]],"text":"Drag the slider, type a value, or step it with − and +.","through":false,"box":null},{"page":"03","pts":[[63.16888888888888,102.71666666666667],[51.47999999999999,102.71666666666667]],"text":"Folds a pane to one line that sums up its settings.","through":false,"box":null},{"page":"03","pts":[[64.75777777777776,122.63888888888889],[51.47999999999999,122.63888888888889]],"text":"Each colour row has a pill; click it to open the colour pop-out.","through":false,"box":null},{"page":"03","pts":[[110.46888888888888,58.59444444444444],[110.46888888888888,53.25]],"text":"Sets the unit every length is shown and typed in.","through":false,"box":null},{"page":"03","pts":[[122.2022222222222,58.59444444444444],[122.2022222222222,53.25]],"text":"Undo and redo: step back and forth through your changes.","through":false,"box":null},{"page":"03","pts":[[235.6244444444444,61.16111111111111],[241.48,61.16111111111111]],"text":"Shows or hides the construction lines; the arrow picks which ones.","through":false,"box":null},{"page":"03","pts":[[131.02666666666664,156.25],[241.48,156.25]],"text":"Sets the colour round the dial in the preview.","through":false,"box":null},{"page":"03","pts":[[78.2022222222222,166.45555555555555],[78.2022222222222,171.75]],"text":"Runs the hands at real speed, or 60 or 720 times faster.","through":false,"box":null},{"page":"03","pts":[[102.4022222222222,166.45555555555555],[102.4022222222222,171.75]],"text":"The time on the dial; type one, or press Now for the time it is.","through":false,"box":null},{"page":"03","pts":[[167.05777777777777,166.7611111111111],[167.05777777777777,171.75]],"text":"The day slider: drag across twelve hours; a click lands on an hour or on 10:10.","through":false,"box":null},{"page":"03","pts":[[226.2133333333333,166.45555555555555],[226.2133333333333,171.75]],"text":"Zoom in and out; Fit shows the whole page again.","through":false,"box":null},{"page":"06","id":"p06-1","pts":[[78.49127604166667,70.51],[46.02502604166666,70.51]],"text":"Count 1: a single marker, at the start.","through":true,"box":null},{"page":"06","id":"p06-2","pts":[[78.26252604166666,111.8375],[46.02502604166666,111.8375]],"text":"Four markers; the one at 12 is switched off.","through":true,"box":null},{"page":"06","id":"p06-3","pts":[[81.00752604166667,61.36],[112.02502604166666,61.36]],"text":"First in the list, so it is drawn over the bezel.","through":true,"box":null},{"page":"06","id":"p06-4","pts":[[59.04752604166666,80.7275],[46.02502604166666,80.7275]],"text":"Every third position skipped, for the bars.","through":true,"box":null},{"page":"06","id":"p06-5","pts":[[100.22252604166667,72.11125],[112.02502604166666,72.11125]],"text":"Sixteen ticks over 90°: one at each end.","through":true,"box":null},{"page":"06","id":"p06-6","pts":[[93.36002604166666,115.65],[112.02502604166666,115.65]],"text":"Twelve ticks that skip at the numerals.","through":true,"box":null},{"page":"06","id":"p06-7","pts":[[57.29377604166666,100.8575],[46.02502604166666,100.8575]],"text":"Sixty ticks that skip where a marker sits.","through":true,"box":null},{"page":"06","id":"p06-8","pts":[[102.73877604166665,105.35625],[112.02502604166666,105.35625]],"text":"Five numerals over 240°: 10 to 50 in tens.","through":true,"box":null},{"page":"06","id":"p06-9","pts":[[92.82627604166666,94.605],[112.02502604166666,94.605]],"text":"A band grows inwards from its radius.","through":true,"box":null},{"page":"06","id":"p06-10","pts":[[102.73877604166665,84.235],[112.02502604166666,84.235]],"text":"A band only 0.25 mm wide reads as a line.","through":true,"box":null},{"page":"06","id":"p06-11","pts":[[48.753776041666654,90.94500000000001],[46.02502604166666,90.94500000000001]],"text":"Twelve sectors, each in its own colour.","through":true,"box":null},{"page":"06","id":"p06-12","pts":[[111.97638346354167,171.451],[119.71638346354166,171.451]],"text":"Sets which point of a numeral sits on the radius: centre, baseline or top.","through":true,"box":null},{"page":"06","id":"p06-13","pts":[[187.265,67.52556527777779],[187.265,61.212932590590285]],"text":"Drag the grip to move the ring up or down the list.","through":false,"box":null},{"page":"06","id":"p06-14","pts":[[216.8275,67.15056527777779],[216.8275,61.212932590590285]],"text":"The ring at a glance: count and kind, size, radius.","through":false,"box":null},{"page":"06","id":"p06-15","pts":[[200.265,67.15056527777779],[200.265,47.19555741697917]],"text":"Renames the ring.","through":false,"box":null},{"page":"06","id":"p06-16","pts":[[182.89,81.15056527777779],[176.83999999999997,81.15056527777779]],"text":"Hides the ring without deleting it.","through":true,"box":null},{"page":"06","id":"p06-17","pts":[[184.1,119.30437500000001],[184.1,113.13680741697917]],"text":"Picks the ring's kind; its settings stay.","through":false,"box":null},{"page":"06","id":"p06-18","pts":[[211.46999999999997,126.61437500000001],[211.46999999999997,132.2950890684375]],"text":"Its colour, size and radius: click one to set it.","through":false,"box":null},{"page":"06","id":"p06-19","pts":[[212.31999999999996,161.85500000000002],[212.31999999999996,159.26271236489583]],"text":"Moves the selected ring up or down, duplicates or deletes it.","through":false,"box":null},{"page":"06","id":"p06-20","pts":[[196.19999999999996,186.295],[196.19999999999996,188.9404015684375]],"text":"The + opens the fou