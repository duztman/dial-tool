{"leaders":[{"page":"01","pts":[[248.81999999999996,160.11999999999998],[248.81999999999996,164.85999999999999]],"text":"Undo · ⌘Z","through":false,"box":null},{"page":"01","pts":[[255.85999999999999,160.11999999999998],[255.85999999999999,164.85999999999999]],"text":"Redo · ⇧⌘Z","through":false,"box":null},{"page":"03","pts":[[62.80222222222221,69.47222222222223],[51.47999999999999,69.47222222222223]],"text":"Switches the panel; the dial and the time stay as they are.","through":false,"box":null},{"page":"03","pts":[[64.75777777777776,82.91666666666666],[51.47999999999999,82.91666666666666]],"text":"Drag the slider, type a value, or step it with − and +.","through":false,"box":null},{"page":"03","pts":[[63.16888888888888,102.71666666666667],[51.47999999999999,102.71666666666667]],"text":"Folds a pane to one line that sums up its settings.","through":false,"box":null},{"page":"03","pts":[[64.75777777777776,122.63888888888889],[51.47999999999999,122.63888888888889]],"text":"Each colour row has a pill; click it to open the colour pop-out.","through":false,"box":null},{"page":"03","pts":[[110.46888888888888,58.59444444444444],[110.46888888888888,53.25]],"text":"Sets the unit every length is shown and typed in.","through":false,"box":null},{"page":"03","pts":[[122.2022222222222,58.59444444444444],[122.2022222222222,53.25]],"text":"Undo and redo: step back and forth through your changes.","through":false,"box":null},{"page":"03","pts":[[235.6244444444444,61.16111111111111],[241.48,61.16111111111111]],"text":"Shows or hides the construction lines; the arrow picks which ones.","through":false,"box":null},{"page":"03","pts":[[131.02666666666664,156.25],[241.48,156.25]],"text":"Sets the colour round the dial in the preview.","through":false,"box":null},{"page":"03","pts":[[78.2022222222222,166.45555555555555],[78.2022222222222,171.75]],"text":"Runs the hands at real speed, or 60 or 720 times faster.","through":false,"box":null},{"page":"03","pts":[[102.4022222222222,166.45555555555555],[102.4022222222222,171.75]],"text":"The time on the dial; type one, or press Now for the time it is.","through":false,"box":null},{"page":"03","pts":[[167.05777777777777,166.7611111111111],[167.05777777777777,171.75]],"text":"The day slider: drag across twelve hours; a click lands on an hour or on 10:10.","through":false,"box":null},{"page":"03","pts":[[226.2133333333333,166.45555555555555],[226.2133333333333,171.75]],"text":"Zoom in and out; Fit shows the whole page again.","through":false,"box":null},{"page":"06","id":"p06-1","pts":[[79.24113606770833,50.35103448275862],[46.28363606770833,50.35103448275862]],"text":"Count 1: a single marker, at the start.","through":true,"box":null},{"page":"06","id":"p06-2","pts":[[81.79863606770833,41.05103448275862],[113.28363606770833,41.05103448275862]],"text":"First in the list, so it is drawn over the bezel.","through":true,"box":null},{"page":"06","id":"p06-3","pts":[[95.82613606770833,89.33353448275861],[113.28363606770833,89.33353448275861]],"text":"Sixty ticks that skip where a marker sits.","through":true,"box":null},{"page":"06","id":"p06-4","pts":[[79.00863606770832,92.35603448275862],[46.28363606770833,92.35603448275862]],"text":"Four markers; the one at 12 is switched off.","through":true,"box":null},{"page":"06","id":"p06-5","pts":[[101.32863606770833,51.97853448275862],[113.28363606770833,51.97853448275862]],"text":"Sixteen ticks over a 90° span: one at each end.","through":true,"box":null},{"page":"06","id":"p06-6","pts":[[59.47863606770832,60.89103448275862],[46.28363606770833,60.89103448275862]],"text":"Every third position skipped, for the bars.","through":true,"box":null},{"page":"06","id":"p06-7","pts":[[81.17863606770833,100.02853448275863],[113.28363606770833,100.02853448275863]],"text":"Five numerals over 240°: 10 to 50 in tens.","through":true,"box":null},{"page":"06","id":"p06-8","pts":[[93.81113606770832,74.68603448275861],[113.28363606770833,74.68603448275861]],"text":"A band's width grow